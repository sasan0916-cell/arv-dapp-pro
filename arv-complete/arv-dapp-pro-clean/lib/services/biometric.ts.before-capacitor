// ============================================================
// توابع جدید برای ذخیره امن رمز عبور با WebCrypto
// ============================================================

const PRF_KEY_PREFIX = 'arv_prf_';

async function deriveKeySafe(secret: string, salt: Uint8Array): Promise<CryptoKey> {
  const enc = new TextEncoder();
  const keyMaterial = await crypto.subtle.importKey(
    'raw',
    enc.encode(secret),
    { name: 'PBKDF2' },
    false,
    ['deriveKey']
  );
  // تبدیل salt به BufferSource معتبر
  const saltBuffer = new Uint8Array(salt).buffer;
  return crypto.subtle.deriveKey(
    {
      name: 'PBKDF2',
      salt: saltBuffer,
      iterations: 100000,
      hash: 'SHA-256',
    },
    keyMaterial,
    { name: 'AES-GCM', length: 256 },
    false,
    ['encrypt', 'decrypt']
  );
}

export async function savePasswordSecurely(walletId: string, password: string): Promise<void> {
  try {
    const stored = localStorage.getItem(`${CRED_KEY_PREFIX}${walletId}`);
    if (!stored) return;
    const data = JSON.parse(stored);
    const secret = `arv_${walletId}_${data.id.slice(0, 16)}`;

    const salt = crypto.getRandomValues(new Uint8Array(16));
    const iv = crypto.getRandomValues(new Uint8Array(new ArrayBuffer(12)));
    const key = await deriveKeySafe(secret, salt);
    const enc = new TextEncoder();
    const encrypted = await crypto.subtle.encrypt(
      { name: 'AES-GCM', iv: new Uint8Array(iv).buffer },
      key,
      enc.encode(password)
    );

    const combined = new Uint8Array(salt.length + iv.length + encrypted.byteLength);
    combined.set(salt, 0);
    combined.set(iv, salt.length);
    combined.set(new Uint8Array(encrypted), salt.length + iv.length);

    localStorage.setItem(`${PRF_KEY_PREFIX}${walletId}`, btoa(String.fromCharCode(...combined)));
  } catch (e) {
    console.error('savePasswordSecurely failed', e);
  }
}

export async function getPasswordWithBiometric(walletId: string): Promise<string | null> {
  try {
    const stored = localStorage.getItem(`${CRED_KEY_PREFIX}${walletId}`);
    const encryptedData = localStorage.getItem(`${PRF_KEY_PREFIX}${walletId}`);
    if (!stored || !encryptedData) return null;

    const data = JSON.parse(stored);
    const secret = `arv_${walletId}_${data.id.slice(0, 16)}`;
    const combined = Uint8Array.from(atob(encryptedData), (c) => c.charCodeAt(0));

    const salt = combined.slice(0, 16);
    const iv = combined.slice(16, 28);
    const encrypted = combined.slice(28);

    const key = await deriveKeySafe(secret, salt);
    const decrypted = await crypto.subtle.decrypt(
      { name: 'AES-GCM', iv: new Uint8Array(iv).buffer },
      key,
      new Uint8Array(encrypted).buffer
    );
    return new TextDecoder().decode(decrypted);
  } catch (e) {
    console.error('getPasswordWithBiometric failed', e);
    return null;
  }
}


// ============================================================
// WebAuthn PRF Extension برای ذخیره امن رمز با اثر انگشت
// ============================================================

const BIO_SUFFIX = '_bio';

const b64 = (b: ArrayBuffer | Uint8Array): string =>
  btoa(String.fromCharCode(...new Uint8Array(b as ArrayBuffer)));

const unb64 = (s: string): Uint8Array<ArrayBuffer> => {
  const bin = atob(s);
  const out = new Uint8Array(new ArrayBuffer(bin.length));
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
};

async function prfKey(credId: BufferSource, salt: Uint8Array<ArrayBuffer>): Promise<CryptoKey> {
  const assertion = (await navigator.credentials.get({
    publicKey: {
      challenge: crypto.getRandomValues(new Uint8Array(32)),
      allowCredentials: [{ type: 'public-key', id: credId }],
      userVerification: 'required',
      extensions: { prf: { eval: { first: salt } } },
    } as any,
  })) as PublicKeyCredential;

  const prfResults = (assertion.getClientExtensionResults() as any).prf?.results?.first;
  if (!prfResults) throw new Error('PRF_UNSUPPORTED');

  return crypto.subtle.importKey('raw', prfResults, 'AES-GCM', false, ['encrypt', 'decrypt']);
}

export async function enableBiometricPRF(
  walletId: string,
  label: string,
  password: string
): Promise<boolean> {
  if (!(await isBiometricAvailable())) throw new Error('BIOMETRIC_UNAVAILABLE');

  const salt = crypto.getRandomValues(new Uint8Array(new ArrayBuffer(32)));

  const cred = (await navigator.credentials.create({
    publicKey: {
      challenge: crypto.getRandomValues(new Uint8Array(32)),
      rp: { name: RP_NAME, id: window.location.hostname },
      user: {
        id: new TextEncoder().encode(walletId),
        name: label,
        displayName: label,
      },
      pubKeyCredParams: [
        { type: 'public-key', alg: -7 },
        { type: 'public-key', alg: -257 },
      ],
      authenticatorSelection: {
        authenticatorAttachment: 'platform',
        userVerification: 'required',
        residentKey: 'preferred',
      },
      extensions: { prf: {} },
    } as any,
  })) as PublicKeyCredential;

  if (!cred) throw new Error('CREDENTIAL_FAILED');

  const prfEnabled = (cred.getClientExtensionResults() as any).prf?.enabled;
  if (!prfEnabled) throw new Error('PRF_UNSUPPORTED');

  const key = await prfKey(cred.rawId, salt);
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const ct = await crypto.subtle.encrypt(
    { name: 'AES-GCM', iv },
    key,
    new TextEncoder().encode(password)
  );

  localStorage.setItem(
    'arv_' + walletId + BIO_SUFFIX,
    JSON.stringify({
      credId: b64(cred.rawId),
      salt: b64(salt),
      iv: b64(iv),
      ct: b64(ct),
    })
  );

  return true;
}

export function isBiometricEnabledPRF(walletId: string): boolean {
  return !!localStorage.getItem('arv_' + walletId + BIO_SUFFIX);
}

export async function unlockWithBiometricPRF(walletId: string): Promise<string> {
  const raw = localStorage.getItem('arv_' + walletId + BIO_SUFFIX);
  if (!raw) throw new Error('BIOMETRIC_NOT_ENABLED');

  const d = JSON.parse(raw);
  const key = await prfKey(unb64(d.credId), unb64(d.salt));
  const pt = await crypto.subtle.decrypt(
    { name: 'AES-GCM', iv: unb64(d.iv) },
    key,
    unb64(d.ct)
  );

  return new TextDecoder().decode(pt);
}

export function disableBiometricPRF(walletId: string): void {
  localStorage.removeItem('arv_' + walletId + BIO_SUFFIX);
}
