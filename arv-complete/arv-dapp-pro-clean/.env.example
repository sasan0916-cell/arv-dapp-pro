# رمز ورود مدیر (قوی و منحصربه‌فرد؛ در هیچ فایل دیگری ننویسید)
ADMIN_PASSWORD=
# رشتهٔ تصادفی حداقل ۳۲ کاراکتر برای امضای نشست. تولید: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# WalletConnect / Reown AppKit project id. Required for QR/deep-link external wallets.
# Create one in the WalletConnect/Reown developer dashboard.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ARV Mainnet contract. When a valid 0x...40-hex address is supplied,
# ARV Super DApp automatically switches its ARV mode from BSC Testnet to BSC Mainnet.
# No code change is required for the release switch.
NEXT_PUBLIC_ARV_MAINNET_ADDRESS=

# Optional: improves on-chain ARV transfer history queries.
NEXT_PUBLIC_BSCSCAN_API_KEY=
