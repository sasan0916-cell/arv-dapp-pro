# ═══════════════════════════════════════════════════════════
# ARV Super DApp — Environment Variables
# ═══════════════════════════════════════════════════════════

# ─── Admin ───────────────────────────────────────────────────
# رمز ورود مدیر (قوی و منحصربه‌فرد؛ در هیچ فایل دیگری ننویسید)
ADMIN_PASSWORD=
# رشتهٔ تصادفی حداقل ۳۲ کاراکتر برای امضای نشست. تولید: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# ─── WalletConnect ───────────────────────────────────────────
# WalletConnect / Reown AppKit project id. Required for QR/deep-link external wallets.
# Create one in the WalletConnect/Reown developer dashboard.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── ARV Token Addresses ─────────────────────────────────────
# Testnet ARV Token (BSC Testnet chainId 97)
NEXT_PUBLIC_ARV_TESTNET_ADDRESS=0x049C66b452f650a0d5F51536f5bC03f249C5163A

# Mainnet ARV Token (BSC Mainnet chainId 56) — leave empty until deployed
NEXT_PUBLIC_ARV_MAINNET_ADDRESS=

# ─── ARV Wallets ─────────────────────────────────────────────
# Main wallet (60% share)
NEXT_PUBLIC_WALLET_MAIN_ADDRESS=0xface68c6507ee71090ddcbbb686f86f69508ccf6
NEXT_PUBLIC_WALLET_MAIN_AMOUNT=6000000

# Reward wallet (40% share)
NEXT_PUBLIC_WALLET_REWARD_ADDRESS=0xf912aea6031de1e6d3446e4a7a8d1166328edbe2
NEXT_PUBLIC_WALLET_REWARD_AMOUNT=4000000

# ─── BscScan (optional) ──────────────────────────────────────
# Optional: improves on-chain ARV transfer history queries.
NEXT_PUBLIC_BSCSCAN_API_KEY=
