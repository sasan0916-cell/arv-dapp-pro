'use client';
import { useEffect, useState } from 'react';
import { useRouter } from 'next/navigation';
import { ArrowRight, Bell, Plus, Trash2, AlertCircle, TrendingUp, TrendingDown, Check } from 'lucide-react';
import { GlowCard } from '@/components/ui/GlowCard';
import { GradientButton } from '@/components/ui/GradientButton';
import TokenLogo from '@/components/ui/TokenLogo';
import { useLanguage } from '@/lib/i18n';
import { fetchLivePrices, type PriceData } from '@/lib/services/price-service';
import { loadAlerts, addAlert, removeAlert, checkAlerts, type PriceAlert } from '@/lib/services/price-alerts';

const TOKENS = ['ARV', 'BNB', 'BTC', 'ETH', 'SOL', 'XRP', 'USDT', 'USDC', 'DOGE', 'ADA', 'MATIC', 'DOT'];

export default function AlertsPage() {
  const router = useRouter();
  const { language } = useLanguage();
  const en = language === 'en';

  const [alerts, setAlerts] = useState<PriceAlert[]>([]);
  const [prices, setPrices] = useState<Record<string, PriceData>>({});
  const [symbol, setSymbol] = useState('BNB');
  const [targetPrice, setTargetPrice] = useState('');
  const [condition, setCondition] = useState<'above' | 'below'>('above');
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    (async () => {
      const list = await loadAlerts();
      setAlerts(list);
      const data = await fetchLivePrices();
      setPrices(data);
      setLoading(false);
    })();
  }, []);

  useEffect(() => {
    const interval = setInterval(async () => {
      const data = await fetchLivePrices();
      setPrices(data);
      const triggered = await checkAlerts(data);
      if (triggered.length > 0) {
        for (const alert of triggered) {
          if (typeof window !== 'undefined' && 'Notification' in window && Notification.permission === 'granted') {
            new Notification(`ARV Alert: ${alert.symbol}`, {
              body: `${alert.symbol} ${alert.condition === 'above' ? 'بالاتر از' : 'پایین‌تر از'} $${alert.targetPrice}`,
              icon: '/arv-logo.png',
            });
          }
        }
      }
    }, 60000);
    return () => clearInterval(interval);
  }, []);

  const handleAdd = async () => {
    setError('');
    setSuccess('');
    const price = parseFloat(targetPrice);
    if (isNaN(price) || price <= 0) {
      setError(en ? 'Target price must be a number' : 'قیمت هدف باید عدد باشد');
      return;
    }
    const next = await addAlert({ symbol, targetPrice: price, condition });
    setAlerts(next);
    setTargetPrice('');
    setSuccess(en ? 'Alert added' : 'هشدار اضافه شد');
    setTimeout(() => setSuccess(''), 2000);
    if (typeof window !== 'undefined' && 'Notification' in window && Notification.permission === 'default') {
      Notification.requestPermission();
    }
  };

  const handleRemove = async (id: string) => {
    const next = await removeAlert(id);
    setAlerts(next);
  };

  const currentPrice = prices[symbol]?.price;

  return (
    <div className="min-h-screen bg-[var(--arv-blue-dark)]">
      <div className="p-4 md:p-6 max-w-lg mx-auto space-y-4">
        <div className="flex items-center gap-3">
          <button onClick={() => router.back()} className="p-2 rounded-lg hover:bg-[var(--arv-blue)]/40 text-[var(--arv-gold)]">
            <ArrowRight size={20} />
          </button>
          <div>
            <h1 className="text-xl font-bold gold-gradient">{en ? 'Price Alerts' : 'هشدارهای قیمت'}</h1>
            <p className="text-xs text-[var(--arv-text-muted)] mt-1">
              {en ? 'Get notified when price hits your target' : 'وقتی قیمت به هدف رسید، مطلع شوید'}
            </p>
          </div>
        </div>

        <GlowCard glowColor="gold">
          <div className="text-xs text-[var(--arv-text-muted)] mb-2">{en ? 'Add Alert' : 'افزودن هشدار'}</div>
          <div className="flex items-center gap-2 mb-3">
            <TokenLogo symbol={symbol} size={32} />
            <select value={symbol} onChange={(e) => setSymbol(e.target.value)} className="flex-1 p-3 rounded-xl bg-[var(--arv-blue)]/40 border border-[var(--arv-gold)]/30 text-white outline-none">
              {TOKENS.map((t) => (<option key={t} value={t}>{t}</option>))}
            </select>
          </div>
          {currentPrice !== undefined && (
            <div className="text-[11px] text-[var(--arv-text-muted)] mb-2 text-center" dir="ltr">
              {en ? 'Current' : 'قیمت فعلی'}: ${currentPrice < 1 ? currentPrice.toFixed(6) : currentPrice.toLocaleString()}
            </div>
          )}
          <div className="grid grid-cols-2 gap-2 mb-3">
            <button onClick={() => setCondition('above')} className={`flex items-center justify-center gap-1 py-2 rounded-lg text-xs font-bold transition-all ${condition === 'above' ? 'bg-[var(--arv-success)]/20 text-[var(--arv-success)] border border-[var(--arv-success)]/50' : 'bg-[var(--arv-blue)]/40 text-[var(--arv-text-muted)]'}`}>
              <TrendingUp size={14} /> {en ? 'Above' : 'بالاتر از'}
            </button>
            <button onClick={() => setCondition('below')} className={`flex items-center justify-center gap-1 py-2 rounded-lg text-xs font-bold transition-all ${condition === 'below' ? 'bg-red-500/20 text-red-400 border border-red-500/50' : 'bg-[var(--arv-blue)]/40 text-[var(--arv-text-muted)]'}`}>
              <TrendingDown size={14} /> {en ? 'Below' : 'پایین‌تر از'}
            </button>
          </div>
          <div className="flex gap-2 mb-3">
            <input type="number" value={targetPrice} onChange={(e) => setTargetPrice(e.target.value)} placeholder={en ? 'Target price...' : 'قیمت هدف...'} className="flex-1 p-3 rounded-xl bg-[var(--arv-blue)]/40 border border-[var(--arv-gold)]/30 text-white outline-none" dir="ltr" />
          </div>
          <GradientButton variant="gold" size="md" fullWidth onClick={handleAdd} icon={<Plus size={16} />}>
            {en ? 'Add Alert' : 'افزودن هشدار'}
          </GradientButton>
          {error && (<div className="mt-3 flex items-center gap-2 text-red-400 text-xs"><AlertCircle size={14} /> {error}</div>)}
          {success && (<div className="mt-3 flex items-center gap-2 text-[var(--arv-success)] text-xs"><Check size={14} /> {success}</div>)}
        </GlowCard>

        <GlowCard glowColor="blue">
          <div className="flex items-center gap-2 mb-3">
            <Bell size={16} className="text-[var(--arv-gold)]" />
            <div className="text-sm font-bold">{en ? 'Your alerts' : 'هشدارهای شما'}</div>
            <div className="text-xs text-[var(--arv-text-muted)] mr-auto">({alerts.length})</div>
          </div>
          {loading ? (<div className="text-center py-6 text-xs text-[var(--arv-text-muted)]">{en ? 'Loading...' : 'در حال بارگذاری...'}</div>) : alerts.length === 0 ? (
            <div className="text-center py-6 text-xs text-[var(--arv-text-muted)]">{en ? 'No alerts yet' : 'هنوز هشداری ندارید'}</div>
          ) : (
            <div className="space-y-2">
              {alerts.map((alert) => {
                const current = prices[alert.symbol]?.price;
                return (
                  <div key={alert.id} className={`flex items-center gap-3 p-3 rounded-xl ${alert.triggered ? 'bg-[var(--arv-success)]/10 border border-[var(--arv-success)]/30' : 'bg-[var(--arv-blue)]/30'}`}>
                    <TokenLogo symbol={alert.symbol} size={32} />
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-1 font-bold text-sm">
                        {alert.symbol}
                        {alert.condition === 'above' ? <TrendingUp size={12} className="text-[var(--arv-success)]" /> : <TrendingDown size={12} className="text-red-400" />}
                      </div>
                      <div className="text-[10px] text-[var(--arv-text-muted)]" dir="ltr">
                        {alert.condition === 'above' ? '≥' : '≤'} ${alert.targetPrice}
                        {current !== undefined && (<span className="ml-2 opacity-60">now: ${current < 1 ? current.toFixed(6) : current.toFixed(2)}</span>)}
                      </div>
                    </div>
                    {alert.triggered && <Check size={16} className="text-[var(--arv-success)]" />}
                    <button onClick={() => handleRemove(alert.id)} className="p-2 rounded-lg hover:bg-red-500/20 text-red-400"><Trash2 size={16} /></button>
                  </div>
                );
              })}
            </div>
          )}
        </GlowCard>

        <GlowCard glowColor="gold">
          <div className="text-xs text-[var(--arv-text-muted)] space-y-1">
            <div className="font-bold text-white mb-1">{en ? 'How it works' : 'نحوه کار'}</div>
            <div>• {en ? 'Set a target price for any token' : 'برای هر توکن یک قیمت هدف تعیین کنید'}</div>
            <div>• {en ? 'Get a browser notification when price hits target' : 'وقتی قیمت به هدف رسید، اعلان مرورگر دریافت کنید'}</div>
            <div>• {en ? 'Alerts are stored locally on your device' : 'هشدارها به صورت محلی روی دستگاه شما ذخیره می‌شوند'}</div>
          </div>
        </GlowCard>
      </div>
    </div>
  );
}
